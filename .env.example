# Docker host path mounted at /data inside the container.
GROVE_DATA_PATH=./data
# Run as the owner of GROVE_DATA_PATH. On Linux, obtain these with `id -u` and `id -g`.
GROVE_UID=1000
GROVE_GID=1000

# Used only when running Grove directly outside Docker.
GROVE_DATA_DIR=./data
GROVE_PUBLIC_URL=http://127.0.0.1:8000
# Optional override. Use only a lowercase domain name without scheme or port.
# GROVE_SERVER_NAME=grove.example.com
GROVE_MAX_BLOB_SIZE=104857600
GROVE_AUTH_CLOCK_SKEW_SECONDS=30
